 (prgm)  "$MOLCAS"/bin/eda.exe                    executable
 (file)  EDAINP   "$WorkDir/$Project."Eda.Input   rwi
#include "aoints.inc"
#include "orbitals.inc"

/*
 * EDA fragment RunFiles are multifiles.  The '*' attribute lets the
 * Driver append the suffix used in the logical RunFile name to the
 * physical file name, e.g.
 *
 *   EDAFRG1 -> $WorkDir/$Project.EdaFrag1
 *   EDAFR10 -> $WorkDir/$Project.EdaFrag10
 *   EDAFR25 -> $WorkDir/$Project.EdaFrag25
 *
 * The two declarations preserve the aliases generated by
 * Fragment_RunName() in eda_reference.F90 for fragment indices 1--999.
 */
 (file)  EDAFRG   "$WorkDir/$Project."EdaFrag      ro*
 (file)  EDAFR    "$WorkDir/$Project."EdaFrag      ro*
