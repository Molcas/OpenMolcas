>export MOLCAS_CI_VERIFY=NO

&GATEWAY
 coord
6

H 0.0 0.0 0.0
H 0.0 0.0 1.0
H 0.0 0.0 2.0
H 0.0 0.0 3.0
H 0.0 0.0 4.0
H 0.0 0.0 5.0
 basis=ANO-RCC-MB
 Group=NoSym
 RICD
&SEWARD

&RASSCF
 nActEl = 6 0 0
 Inactive = 0
 Ras2 = 6
 Spin = 1
 CIRoot = 3 3 1
 XMSI
 FARO
>>COPY $Project.JobIph JOB001

&CASPT2
 Multistate = 3 1 2 3
 Imaginary = 0.1

&RASSI
 Nr of JobIph = 1 3; 1 2 3

&RASSCF
 nActEl = 6 0 0
 Inactive = 0
 Ras2 = 6
 CIONLY
 Spin = 3
 PRSP
 CIRoot = 2 2 1
 FARO

&RASSCF
 nActEl = 5 0 0
 Inactive = 0
 Ras2 = 6
 CIONLY
 Spin = 2
 PRSP
 FARO

&RASSCF
 nActEl = 6 0 0
 Inactive = 0
 Ras2 = 6
 CIONLY
 Spin = 5
 PRSP
 FARO

