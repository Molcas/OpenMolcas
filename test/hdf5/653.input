*-------------------------------------------------------------------------------
* System: HF (hand-written for this test; the cheapest single-state
*             optimization available -- a two-atom RHF/STO-3G job)
* Basis: STO-3G
* Features tested: slapaf.h5 must gain NONE of the conical-intersection /
*                   MECI datasets or attributes for an ordinary single-state
*                   geometry optimization with no two-state constraint.
* Responsible person: Luca De Vico
*-------------------------------------------------------------------------------
* This is the negative control: it verifies that GRADIENT_DIFFERENCE, NAC,
* ROOT_INDICES, APPROX_NADC, NADC, EDIFF_ZERO and TWO_RUNFILES are all
* conditionally created and therefore absent here, while the ordinary
* datasets (ENERGIES, COORDINATES, FORCES, NROOTS, ROOT_ENERGIES) are still
* present and correctly shaped. None of this is visible to the ordinary
* checkfile mechanism, since Add_Info only ever sees the in-memory value at
* the call site and never the written file. Numerical values remain the
* responsibility of the checkfile below.
*-------------------------------------------------------------------------------

* Test HDF5 support
> RM -FORCE TEST_HDF5
> IF ( $MOLCAS_DRIVER = UNKNOWN_VARIABLE )
>   EXPORT MOLCAS_DRIVER=molcas
> ENDIF
> SHELL $MOLCAS_DRIVER have_feature hdf5 || touch TEST_HDF5
> IF ( -FILE TEST_HDF5 )
>   EXIT 36
> ENDIF

* Test h5py support (the structure check below needs it)
> RM -FORCE TEST_H5PY
> SHELL python3 -c "import h5py" || touch TEST_H5PY
> IF ( -FILE TEST_H5PY )
>   EXIT 36
> ENDIF

>FILE check_no_ci.py
#
# Structure check for slapaf.h5: a plain single-state optimization must gain
# NONE of the conical-intersection / MECI datasets and attributes. This is
# the whole contract of their conditional creation -- an ordinary run's file
# must be unaffected.
#
# Exits 0 on success, 1 on any failure. A nonzero exit trips MOLCAS_TRAP and is
# reported by the verify script as a test failure.
#
import sys
import glob

import h5py
import numpy as np

failures = []
notes = []


def fail(msg):
    failures.append(msg)


def as_int(value):
    """mh5 attributes may arrive as a scalar or as a length-1 array."""
    arr = np.atleast_1d(np.asarray(value))
    if arr.size != 1:
        raise ValueError('expected a scalar attribute, got size %d' % arr.size)
    return int(arr[0])


def locate():
    if len(sys.argv) > 1 and glob.glob(sys.argv[1]):
        return sys.argv[1]
    candidates = sorted(glob.glob('*.slapaf.h5'))
    if not candidates:
        sys.stderr.write('FATAL: no slapaf.h5 found (argv=%s)\n' % sys.argv[1:])
        sys.exit(1)
    if len(candidates) > 1:
        notes.append('multiple slapaf.h5 present, using %s' % candidates[0])
    return candidates[0]


path = locate()

with h5py.File(path, 'r') as f:

    # --- D1: none of the conditional CI datasets exist ----------------------
    for name in ('GRADIENT_DIFFERENCE', 'NAC', 'ROOT_INDICES', 'APPROX_NADC'):
        if name in f:
            fail('D1: %s dataset is present in a single-state run' % name)

    # --- D2: none of the conditional CI attributes exist --------------------
    for attr in ('NADC', 'EDIFF_ZERO', 'TWO_RUNFILES'):
        if attr in f.attrs:
            fail('D2: %s attribute is present in a single-state run' % attr)

    # --- D3: the ordinary datasets are still present and correctly shaped --
    if 'ITERATIONS' not in f.attrs:
        fail('D3: ITERATIONS attribute is missing')
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)
    niter = as_int(f.attrs['ITERATIONS'])
    if niter < 1:
        fail('D3: ITERATIONS = %d, expected >= 1' % niter)

    if 'NROOTS' not in f.attrs:
        fail('D3: NROOTS attribute is missing')
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)
    nroots = as_int(f.attrs['NROOTS'])

    for name in ('ENERGIES', 'COORDINATES', 'FORCES', 'ROOT_ENERGIES'):
        if name not in f:
            fail('D3: %s dataset is missing' % name)
    if failures:
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)

    energies = f['ENERGIES'][...]
    coords = f['COORDINATES'][...]
    forces = f['FORCES'][...]
    root_e = f['ROOT_ENERGIES'][...]

    if energies.shape[0] != niter:
        fail('D3: ENERGIES leading dimension %d != ITERATIONS %d' % (energies.shape[0], niter))
    if coords.shape[0] != niter:
        fail('D3: COORDINATES leading dimension %d != ITERATIONS %d' % (coords.shape[0], niter))
    if forces.shape[0] != niter:
        fail('D3: FORCES leading dimension %d != ITERATIONS %d' % (forces.shape[0], niter))
    if root_e.shape != (niter, nroots):
        fail('D3: ROOT_ENERGIES shape is %s, expected %s' % (root_e.shape, (niter, nroots)))

if failures:
    sys.stderr.write('\nslapaf.h5 structure check FAILED (%s)\n' % path)
    for item in failures:
        sys.stderr.write('  %s\n' % item)
    sys.exit(1)

for item in notes:
    sys.stdout.write('  note: %s\n' % item)
sys.stdout.write('slapaf.h5 negative-control check passed: ITERATIONS=%d '
                 'NROOTS=%d, no CI/MECI datasets or attributes present\n'
                 % (niter, nroots))
sys.exit(0)
>EOF

