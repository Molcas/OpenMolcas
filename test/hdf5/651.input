*-------------------------------------------------------------------------------
* System: C2H4 (as in test/additional/875.input)
* Basis: 6-31G (as in test/additional/875.input)
* Features tested: slapaf.h5 GRADIENT_DIFFERENCE / NAC / ROOT_INDICES /
*                   APPROX_NADC structure for a conical-intersection
*                   optimization on the full analytic-coupling path (the
*                   nonadiabatic coupling vector is computed directly, not
*                   approximated).
* Responsible person: Luca De Vico
*-------------------------------------------------------------------------------
* This test verifies properties of the slapaf.h5 file itself for a conical
* intersection search -- that the new CI/MECI datasets and attributes are
* created, correctly shaped, and free of unwritten (fill-value) rows -- none
* of which the ordinary checkfile mechanism can observe, since Add_Info only
* ever sees the in-memory value at the call site and never the written file.
* Numerical values remain the responsibility of the checkfile below.
*-------------------------------------------------------------------------------

* Test HDF5 support
> RM -FORCE TEST_HDF5
> IF ( $MOLCAS_DRIVER = UNKNOWN_VARIABLE )
>   EXPORT MOLCAS_DRIVER=molcas
> ENDIF
> SHELL $MOLCAS_DRIVER have_feature hdf5 || touch TEST_HDF5
> IF ( -FILE TEST_HDF5 )
>   EXIT 36
> ENDIF

* Test h5py support (the structure check below needs it)
> RM -FORCE TEST_H5PY
> SHELL python3 -c "import h5py" || touch TEST_H5PY
> IF ( -FILE TEST_H5PY )
>   EXIT 36
> ENDIF

>FILE check_ci_full.py
#
# Structure check for slapaf.h5: conical-intersection datasets on the full
# analytic-coupling path (the nonadiabatic coupling vector is computed
# directly, not approximated).
#
# Asserts only what Add_Info cannot see: that GRADIENT_DIFFERENCE, NAC,
# ROOT_INDICES and APPROX_NADC are created, correctly shaped, and free of
# unwritten (fill-value) rows, and that the NADC/EDIFF_ZERO/TWO_RUNFILES
# attributes carry the expected values for this system. Numerical values
# remain the responsibility of the checkfile.
#
# Exits 0 on success, 1 on any failure. A nonzero exit trips MOLCAS_TRAP and is
# reported by the verify script as a test failure.
#
import sys
import glob

import h5py
import numpy as np

failures = []
notes = []


def fail(msg):
    failures.append(msg)


def as_int(value):
    """mh5 attributes may arrive as a scalar or as a length-1 array."""
    arr = np.atleast_1d(np.asarray(value))
    if arr.size != 1:
        raise ValueError('expected a scalar attribute, got size %d' % arr.size)
    return int(arr[0])


def locate():
    if len(sys.argv) > 1 and glob.glob(sys.argv[1]):
        return sys.argv[1]
    candidates = sorted(glob.glob('*.slapaf.h5'))
    if not candidates:
        sys.stderr.write('FATAL: no slapaf.h5 found (argv=%s)\n' % sys.argv[1:])
        sys.exit(1)
    if len(candidates) > 1:
        notes.append('multiple slapaf.h5 present, using %s' % candidates[0])
    return candidates[0]


path = locate()

with h5py.File(path, 'r') as f:

    if 'ITERATIONS' not in f.attrs:
        sys.stderr.write('FATAL: ITERATIONS attribute is missing\n')
        sys.exit(1)
    niter = as_int(f.attrs['ITERATIONS'])

    if 'NATOMS_UNIQUE' not in f.attrs:
        sys.stderr.write('FATAL: NATOMS_UNIQUE attribute is missing\n')
        sys.exit(1)
    natoms = as_int(f.attrs['NATOMS_UNIQUE'])

    # --- B1: GRADIENT_DIFFERENCE and NAC exist, rank 3 ----------------------
    for name in ('GRADIENT_DIFFERENCE', 'NAC'):
        if name not in f:
            fail('B1: %s dataset is missing' % name)
    if failures:
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)

    grad_diff = f['GRADIENT_DIFFERENCE'][...]
    nac = f['NAC'][...]

    if grad_diff.ndim != 3:
        fail('B1: GRADIENT_DIFFERENCE has rank %d, expected 3' % grad_diff.ndim)
    if nac.ndim != 3:
        fail('B1: NAC has rank %d, expected 3' % nac.ndim)
    if failures:
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)

    # --- B2: exact shape (ITERATIONS, NATOMS_UNIQUE, 3) ---------------------
    # This is a transpose check: it only catches a reversed/scrambled axis
    # order because ITERATIONS, NATOMS_UNIQUE and 3 are mutually distinct for
    # this system (5, 6 and 3). A future host system for this test must keep
    # all three distinct, or a transposed dataset could accidentally pass.
    expected = (niter, natoms, 3)
    if grad_diff.shape != expected:
        fail('B2: GRADIENT_DIFFERENCE shape is %s, expected %s' % (grad_diff.shape, expected))
    if nac.shape != expected:
        fail('B2: NAC shape is %s, expected %s' % (nac.shape, expected))

    # --- B3: leading dimension agrees with ENERGIES/COORDINATES/FORCES -----
    energies = f['ENERGIES'][...]
    coords = f['COORDINATES'][...]
    forces = f['FORCES'][...]
    for name, arr in (('ENERGIES', energies), ('COORDINATES', coords), ('FORCES', forces)):
        if arr.shape[0] != niter:
            fail('B3: %s leading dimension %d != ITERATIONS %d' % (name, arr.shape[0], niter))
    if grad_diff.shape[0] != niter:
        fail('B3: GRADIENT_DIFFERENCE leading dimension %d != ITERATIONS %d' % (grad_diff.shape[0], niter))
    if nac.shape[0] != niter:
        fail('B3: NAC leading dimension %d != ITERATIONS %d' % (nac.shape[0], niter))

    # --- B4: ROOT_INDICES exists, shape (ITERATIONS, 2), entries >= 1 -------
    if 'ROOT_INDICES' not in f:
        fail('B4: ROOT_INDICES dataset is missing')
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)
    root_idx = f['ROOT_INDICES'][...]
    if root_idx.shape != (niter, 2):
        fail('B4: ROOT_INDICES shape is %s, expected %s' % (root_idx.shape, (niter, 2)))
    elif np.any(root_idx < 1):
        fail('B4: ROOT_INDICES has entries < 1: %s' % np.array2string(root_idx))

    # --- B5: APPROX_NADC exists, shape (ITERATIONS,), all zero --------------
    if 'APPROX_NADC' not in f:
        fail('B5: APPROX_NADC dataset is missing')
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)
    approx = f['APPROX_NADC'][...]
    if approx.shape != (niter,):
        fail('B5: APPROX_NADC shape is %s, expected %s' % (approx.shape, (niter,)))
    elif np.any(approx != 0):
        fail('B5: APPROX_NADC has %d nonzero entries, expected all 0 (full '
             'analytic coupling should never fall back to the '
             'branching-plane approximation for this system): %s'
             % (int(np.sum(approx != 0)), np.array2string(approx)))

    # --- B6: NADC / EDIFF_ZERO / TWO_RUNFILES attributes --------------------
    expected_attrs = {'NADC': 1, 'EDIFF_ZERO': 1, 'TWO_RUNFILES': 0}
    for attr, want in expected_attrs.items():
        if attr not in f.attrs:
            fail('B6: %s attribute is missing' % attr)
            continue
        got = as_int(f.attrs[attr])
        if got != want:
            fail('B6: %s = %d, expected %d' % (attr, got, want))

    # --- B7: no non-finite entries, no all-zero (unwritten) row -------------
    for name, arr in (('GRADIENT_DIFFERENCE', grad_diff), ('NAC', nac)):
        if not np.all(np.isfinite(arr)):
            bad = np.argwhere(~np.isfinite(arr))
            fail('B7: %s has %d non-finite entries, first at %s'
                 % (name, len(bad), tuple(bad[0])))
        # An unwritten slot retains the HDF5 fill value (0.0) across the
        # entire per-iteration row; a real gradient difference or coupling
        # vector is never exactly zero in every component.
        zero_rows = np.argwhere(np.all(arr == 0.0, axis=(1, 2)))
        if len(zero_rows):
            fail('B7: %s has %d all-zero row(s) (fill-value holes?), first '
                 'at iteration %d' % (name, len(zero_rows), zero_rows[0][0]))

if failures:
    sys.stderr.write('\nslapaf.h5 structure check FAILED (%s)\n' % path)
    for item in failures:
        sys.stderr.write('  %s\n' % item)
    sys.exit(1)

for item in notes:
    sys.stdout.write('  note: %s\n' % item)
sys.stdout.write('slapaf.h5 CI structure check passed: ITERATIONS=%d '
                 'NATOMS_UNIQUE=%d GRADIENT_DIFFERENCE=%s NAC=%s '
                 'ROOT_INDICES=%s APPROX_NADC=%s\n'
                 % (niter, natoms, grad_diff.shape, nac.shape, root_idx.shape, approx.shape))
sys.exit(0)
>EOF

