*-------------------------------------------------------------------------------
* System: CH2NH2+ (as in test/standard/075.input)
* Basis: 6-31G (as in test/standard/075.input)
* Features tested: slapaf.h5 NAC / APPROX_NADC / TWO_RUNFILES structure for a
*                   same-spin conical intersection optimized via the
*                   two-RunFile trick, with an approximate (branching-plane)
*                   coupling vector rather than an analytic one.
* Responsible person: Luca De Vico
*-------------------------------------------------------------------------------
* This test verifies properties of the slapaf.h5 file itself on the
* branching-plane fallback path -- that APPROX_NADC is set whenever NAC holds
* an approximate vector rather than a true coupling derivative -- which the
* ordinary checkfile mechanism cannot observe, since Add_Info only ever sees
* the in-memory value at the call site and never the written file. Numerical
* values remain the responsibility of the checkfile below.
*-------------------------------------------------------------------------------

* Test HDF5 support
> RM -FORCE TEST_HDF5
> IF ( $MOLCAS_DRIVER = UNKNOWN_VARIABLE )
>   EXPORT MOLCAS_DRIVER=molcas
> ENDIF
> SHELL $MOLCAS_DRIVER have_feature hdf5 || touch TEST_HDF5
> IF ( -FILE TEST_HDF5 )
>   EXIT 36
> ENDIF

* Test h5py support (the structure check below needs it)
> RM -FORCE TEST_H5PY
> SHELL python3 -c "import h5py" || touch TEST_H5PY
> IF ( -FILE TEST_H5PY )
>   EXIT 36
> ENDIF

>FILE check_ci_approx.py
#
# Structure check for slapaf.h5: conical-intersection datasets on the
# branching-plane fallback path (approximate coupling, two-RunFile job).
#
# The point of this test is C1: APPROX_NADC must be set at every iteration.
# When the true coupling derivative cannot be computed, NAC instead holds a
# normalized, dimensionless branching-plane vector -- not a physical coupling
# derivative in Eh/a0. A downstream tool that reads NAC without checking
# APPROX_NADC would silently misinterpret that vector's units and magnitude.
# This is the only automated coverage for that fallback path.
#
# Exits 0 on success, 1 on any failure. A nonzero exit trips MOLCAS_TRAP and is
# reported by the verify script as a test failure.
#
import sys
import glob

import h5py
import numpy as np

failures = []
notes = []


def fail(msg):
    failures.append(msg)


def as_int(value):
    """mh5 attributes may arrive as a scalar or as a length-1 array."""
    arr = np.atleast_1d(np.asarray(value))
    if arr.size != 1:
        raise ValueError('expected a scalar attribute, got size %d' % arr.size)
    return int(arr[0])


def locate():
    if len(sys.argv) > 1 and glob.glob(sys.argv[1]):
        return sys.argv[1]
    candidates = sorted(glob.glob('*.slapaf.h5'))
    if not candidates:
        sys.stderr.write('FATAL: no slapaf.h5 found (argv=%s)\n' % sys.argv[1:])
        sys.exit(1)
    if len(candidates) > 1:
        notes.append('multiple slapaf.h5 present, using %s' % candidates[0])
    return candidates[0]


path = locate()

with h5py.File(path, 'r') as f:

    if 'ITERATIONS' not in f.attrs:
        sys.stderr.write('FATAL: ITERATIONS attribute is missing\n')
        sys.exit(1)
    niter = as_int(f.attrs['ITERATIONS'])

    # --- C1: APPROX_NADC exists, every entry == 1 ---------------------------
    if 'APPROX_NADC' not in f:
        fail('C1: APPROX_NADC dataset is missing')
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)
    approx = f['APPROX_NADC'][...]
    if approx.shape != (niter,):
        fail('C1: APPROX_NADC shape is %s, expected %s' % (approx.shape, (niter,)))
    elif np.any(approx != 1):
        fail('C1: APPROX_NADC has %d entries != 1, expected every iteration '
             'to fall back to the branching-plane approximation: %s'
             % (int(np.sum(approx != 1)), np.array2string(approx)))

    # --- C2: NAC exists and is fully populated ------------------------------
    if 'NAC' not in f:
        fail('C2: NAC dataset is missing')
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)
    nac = f['NAC'][...]
    if nac.shape[0] != niter:
        fail('C2: NAC leading dimension %d != ITERATIONS %d' % (nac.shape[0], niter))
    if not np.all(np.isfinite(nac)):
        bad = np.argwhere(~np.isfinite(nac))
        fail('C2: NAC has %d non-finite entries, first at %s' % (len(bad), tuple(bad[0])))
    zero_rows = np.argwhere(np.all(nac == 0.0, axis=tuple(range(1, nac.ndim))))
    if len(zero_rows):
        fail('C2: NAC has %d all-zero row(s) (fill-value holes?), first at '
             'iteration %d' % (len(zero_rows), zero_rows[0][0]))

    # --- C2b: APPROX_NADC[k] == 1 implies a unit-norm NAC[k] -----------------
    # The branching-plane fallback (Maeda/Ohno/Morokuma) is normalized and
    # dimensionless, unlike a true coupling derivative in Eh/a0. Measured at
    # exactly 1.000000 for every iteration of standard/075 (this test), versus
    # 0.0023-0.0088 for additional/875's analytic coupling -- a tight
    # tolerance here would misfire on the analytic path, so this is checked
    # only where APPROX_NADC actually marks the fallback.
    if approx.shape == (niter,) and nac.shape[0] == niter:
        for k in range(niter):
            if approx[k] != 1:
                continue
            norm = np.sqrt(np.sum(nac[k]**2))
            if abs(norm-1.0) > 1.0e-5:
                fail('C2b: iteration %d -- APPROX_NADC = 1 but Frobenius norm '
                     'of NAC = %.6f, expected 1' % (k, norm))

    # --- C3: TWO_RUNFILES == 1 -----------------------------------------------
    if 'TWO_RUNFILES' not in f.attrs:
        fail('C3: TWO_RUNFILES attribute is missing')
    else:
        got = as_int(f.attrs['TWO_RUNFILES'])
        if got != 1:
            fail('C3: TWO_RUNFILES = %d, expected 1' % got)

    # --- C4: ROOT_INDICES shape and range only -------------------------------
    # Deliberately NOT checking the actual values. For this two-RunFile job
    # the pair is (root on the currently active RunFile, root on RUNFILE2),
    # not a sorted (higher, lower) pair -- it only happens to look sorted
    # here because of how this particular input orders its two RlxRoot
    # values. Asserting the exact numbers would encode that accident rather
    # than a real property of the code.
    if 'ROOT_INDICES' not in f:
        fail('C4: ROOT_INDICES dataset is missing')
    else:
        root_idx = f['ROOT_INDICES'][...]
        if root_idx.shape != (niter, 2):
            fail('C4: ROOT_INDICES shape is %s, expected %s' % (root_idx.shape, (niter, 2)))
        elif np.any(root_idx < 1):
            fail('C4: ROOT_INDICES has entries < 1: %s' % np.array2string(root_idx))

if failures:
    sys.stderr.write('\nslapaf.h5 structure check FAILED (%s)\n' % path)
    for item in failures:
        sys.stderr.write('  %s\n' % item)
    sys.exit(1)

for item in notes:
    sys.stdout.write('  note: %s\n' % item)
sys.stdout.write('slapaf.h5 branching-plane structure check passed: '
                 'ITERATIONS=%d APPROX_NADC=%s NAC=%s ROOT_INDICES=%s\n'
                 % (niter, approx.shape, nac.shape, root_idx.shape))
sys.exit(0)
>EOF

