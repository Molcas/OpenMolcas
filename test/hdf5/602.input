*-------------------------------------------------------------------------------
* Molecule: Benzene C6H6
* Basis: ANO
* Symmetry: D2h
* Features tested: CASSCF,RASSCF/RASPT2,HDF5
* Responsible person: S. Vancoillie
*-------------------------------------------------------------------------------
>> RM -FORCE TEST_HDF5
>> IF ( $MOLCAS_DRIVER = UNKNOWN_VARIABLE )
>>   EXPORT MOLCAS_DRIVER=molcas
>> ENDIF
>> SHELL $MOLCAS_DRIVER have_feature hdf5 || touch TEST_HDF5
>> IF ( -FILE TEST_HDF5 )
>>   EXIT 36
>> ENDIF

 &GATEWAY
Title
Benzene, STO-3g Basis set
Coord
12

C1 -1.21689 -0.702573 0
C2  1.21689 -0.702573 0
C3 -1.21689  0.702573 0
C4  1.21689  0.702573 0
C5  0.      -1.40514  0
C6  0.       1.40514  0
H1 -2.15418 -1.24371  0
H2  2.15418 -1.24371  0
H3 -2.15418  1.24371  0
H4  2.15418  1.24371  0
H5  0.      -2.48743  0
H6  0.       2.48743  0
Basis = ANO-S-VDZ
Group = C1
NoCD

 &SEWARD

 &SCF
FILE = $Project.guessorb.h5

 &RASSCF
FILE = $Project.scf.h5
Alter = 2 ; 1 17 19 ; 1 24 30
Symmetry = 1
Spin = 1
Nactel = 6  0  0
Inac =  18
Ras2 =   6
CIRoots = 3 3 1
Iter = 30 100
TDM

>> RM $Project.RasOrb
>> RM $Project.JobIph

 &RASSCF
FILE = $Project.rasscf.h5
H5CI
Symmetry = 1
Spin = 1
Nactel = 6  0  0
Inac =  18
Ras2 =   6
Iter = 20 100
CIRoots = 3 3 1
TDM

>> RM $Project.RasOrb
>> RM $Project.JobIph

 &CASPT2
FILE=$Project.rasscf.h5

 &RASSI
FILEs
1
$Project.caspt2.h5

 &RASSCF
FILE = $Project.scf.h5
Alter = 2 ; 1 17 19 ; 1 24 30
Symmetry = 1
Spin = 3
Nactel = 6  0  0
Inac =  18
Ras2 =   6
CIRoots = 2 2 1
Iter = 30 100
TDM


