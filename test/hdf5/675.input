*-------------------------------------------------------------------------------
* Molecule: LiH
* Basis: STO-3G
* Symmetry: C1 (None)
* Features tested: L-PDFT with translated LDA, GGA, and hybrid functionals;
*                  RI-aCD integrals with an explicit decomposition threshold
* Responsible person: Bhavnesh Jangid, University of Chicago, 2026
* Comments: Runs translated on-top functionals from the same state-averaged
*           reference and checks pure and hybrid L-PDFT energies.
*-------------------------------------------------------------------------------
>> EXPORT MOLCAS_NOCHECK=MLTPL
>> RM -FORCE TEST_HDF5
>> IF ( $MOLCAS_DRIVER = UNKNOWN_VARIABLE )
>>   EXPORT MOLCAS_DRIVER=molcas
>> ENDIF
>> SHELL $MOLCAS_DRIVER have_feature hdf5 || touch TEST_HDF5
>> IF ( -FILE TEST_HDF5 )
>>   EXIT 36
>> ENDIF

&GATEWAY
  Coord
    2
    Angstrom
    Li  0.0  0.0  0.0
    H   0.0  0.0  0.8
  Group = NoSym
  Basis = STO-3G
  RICD
  CDThreshold = 1.0D-6

&SEWARD
  Grid Input
    Grid = Coarse
  End of Grid Input

>> COPY InitOrb $Project.ScfOrb

&RASSCF
  CIONly
  LumOrb
  Spin = 1
  NActEl = 2 0 0
  Inactive = 1
  Ras2 = 2
  CIRoot = 2 2 1
  LPDF

&MCPDFT
  Functional = T:LSDA
  LPDF
  MSPD

&MCPDFT
  Functional = T:PBE
  LPDF
  MSPD

* tPBE0: 25% MCSCF wave-function energy and 75% tPBE energy.
&MCPDFT
  Functional = T:PBE
  LAMB = 0.25
  LPDF
  MSPD

* Strongly hybrid tPBE: 75% MCSCF and 25% tPBE.
&MCPDFT
  Functional = T:PBE
  LAMB = 0.75
  LPDF
  MSPD

>>FILE InitOrb
