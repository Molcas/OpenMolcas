*-------------------------------------------------------------------------------
* Molecule: H3
* Basis: STO-3G
* Symmetry: C1 (None)
* Features tested: L-PDFT for non-integeric spin (Like doublet)
* Responsible person: Bhavnesh Jangid, University of Chicago, 2026
*-------------------------------------------------------------------------------
>> EXPORT MOLCAS_NOCHECK=MLTPL
>> RM -FORCE TEST_HDF5
>> IF ( $MOLCAS_DRIVER = UNKNOWN_VARIABLE )
>>   EXPORT MOLCAS_DRIVER=molcas
>> ENDIF
>> SHELL $MOLCAS_DRIVER have_feature hdf5 || touch TEST_HDF5
>> IF ( -FILE TEST_HDF5 )
>>   EXIT 36
>> ENDIF

&GATEWAY
  Coord
    3
    Angstrom
    H  0.00  0.00  0.00
    H  0.00  0.00  0.90
    H  0.65  0.15  1.55
  Group = NoSym
  Basis = STO-3G
  NoCD

&SEWARD
  Grid Input
    Grid = Coarse
  End of Grid Input

&SCF
  UHF
  Spin = 2

&RASSCF
  FileOrb = $Project.UhfOrb
  AlphaOrBeta = -1
  Spin = 2
  NActEl = 3 0 0
  Inactive = 0
  Ras2 = 3
  CIRoot = 3 3 1
  LPDF

&MCPDFT
  Functional = T:PBE
  LPDF
  MSPD

