*-------------------------------------------------------------------------------
* System: Acrolein (as in test/additional/837.input)
* Basis: 6-31G (as in test/additional/837.input)
* Features tested: slapaf.h5 NROOTS / NROOTS_2 / ROOT_ENERGIES / ROOT_ENERGIES_2
*                   / ROOT_INDICES structure for a singlet-triplet crossing
*                   where the two spins request a DIFFERENT number of roots
*                   (singlet state-averaged over 2 roots, triplet a single
*                   root) -- the case none of 650-653 cover, since all of
*                   them use the same root count on both sides of a
*                   two-RunFile job.
* Responsible person: Luca De Vico
*-------------------------------------------------------------------------------
* This test verifies properties of the slapaf.h5 file itself -- that NROOTS
* and NROOTS_2 are printed as the genuinely different values requested by
* each spin, that ROOT_ENERGIES and ROOT_ENERGIES_2 are shaped accordingly
* (not both sized to the same root count), and that ROOT_INDICES stays
* within bounds for each of the two differently-sized arrays it indexes --
* none of which the ordinary checkfile mechanism can observe, since Add_Info
* only ever sees the in-memory value at the call site and never the written
* file. Numerical values remain the responsibility of the checkfile below.
*
* CAS(2,2) on this molecule has only one triplet CSF (two orbitals, two
* singly-occupied electrons, exactly one way to couple them to a triplet),
* so the extra root has to be requested on the singlet side; this is also
* why this system is a safe choice for exercising a root-count mismatch --
* there is no larger active space for the extra root to accidentally pull
* in an unwanted orbital, unlike a system where the active space itself has
* room to grow.
*-------------------------------------------------------------------------------

* Test HDF5 support
> RM -FORCE TEST_HDF5
> IF ( $MOLCAS_DRIVER = UNKNOWN_VARIABLE )
>   EXPORT MOLCAS_DRIVER=molcas
> ENDIF
> SHELL $MOLCAS_DRIVER have_feature hdf5 || touch TEST_HDF5
> IF ( -FILE TEST_HDF5 )
>   EXIT 36
> ENDIF

* Test h5py support (the structure check below needs it)
> RM -FORCE TEST_H5PY
> SHELL python3 -c "import h5py" || touch TEST_H5PY
> IF ( -FILE TEST_H5PY )
>   EXIT 36
> ENDIF

>FILE check_asym_roots.py
#
# Structure check for slapaf.h5: NROOTS/NROOTS_2/ROOT_ENERGIES/
# ROOT_ENERGIES_2/ROOT_INDICES for a two-RunFile job where the two spins
# request a different number of roots (singlet: 2, triplet: 1).
#
# The point of this test is B1-B4: that a genuine root-count mismatch is
# printed as such (not silently coerced to match), that each ROOT_ENERGIES*
# array is shaped after its own root count, and that ROOT_INDICES stays in
# bounds for both -- this is the only automated coverage for that mismatch,
# since every existing hdf5 test with a two-RunFile job (650-653) happens to
# use the same root count on both sides.
#
# Exits 0 on success, 1 on any failure. A nonzero exit trips MOLCAS_TRAP and is
# reported by the verify script as a test failure.
#
import sys
import glob

import h5py
import numpy as np

TOL = 1.0e-6

failures = []
notes = []


def fail(msg):
    failures.append(msg)


def as_int(value):
    """mh5 attributes may arrive as a scalar or as a length-1 array."""
    arr = np.atleast_1d(np.asarray(value))
    if arr.size != 1:
        raise ValueError('expected a scalar attribute, got size %d' % arr.size)
    return int(arr[0])


def locate():
    if len(sys.argv) > 1 and glob.glob(sys.argv[1]):
        return sys.argv[1]
    candidates = sorted(glob.glob('*.slapaf.h5'))
    if not candidates:
        sys.stderr.write('FATAL: no slapaf.h5 found (argv=%s)\n' % sys.argv[1:])
        sys.exit(1)
    if len(candidates) > 1:
        notes.append('multiple slapaf.h5 present, using %s' % candidates[0])
    return candidates[0]


path = locate()

with h5py.File(path, 'r') as f:

    if 'ITERATIONS' not in f.attrs:
        sys.stderr.write('FATAL: ITERATIONS attribute is missing\n')
        sys.exit(1)
    niter = as_int(f.attrs['ITERATIONS'])

    # --- B1: NROOTS and NROOTS_2 are both present and genuinely different ---
    for attr in ('NROOTS', 'NROOTS_2', 'TWO_RUNFILES', 'EDIFF_ZERO'):
        if attr not in f.attrs:
            fail('B1: %s attribute is missing' % attr)
    if failures:
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)

    nroots = as_int(f.attrs['NROOTS'])
    nroots2 = as_int(f.attrs['NROOTS_2'])
    two_runfiles = as_int(f.attrs['TWO_RUNFILES'])
    ediff_zero = as_int(f.attrs['EDIFF_ZERO'])

    if two_runfiles != 1:
        fail('B1: TWO_RUNFILES = %d, expected 1' % two_runfiles)
    if ediff_zero != 1:
        fail('B1: EDIFF_ZERO = %d, expected 1' % ediff_zero)
    if nroots == nroots2:
        fail('B1: NROOTS == NROOTS_2 == %d; this input deliberately requests '
             'a different number of roots per spin (singlet CiRoot=2 2 1, '
             'triplet single-root) -- an equal count here means the two '
             'RASSCF root counts are being conflated somewhere' % nroots)
    if nroots != 2:
        fail('B1: NROOTS = %d, expected 2 (the active RunFile is the '
             'singlet, copied second in this input)' % nroots)
    if nroots2 != 1:
        fail('B1: NROOTS_2 = %d, expected 1 (RUNFILE2 is the triplet, '
             'copied first, single root)' % nroots2)

    # --- B2: ROOT_ENERGIES / ROOT_ENERGIES_2 shaped after their own root count
    for name in ('ROOT_ENERGIES', 'ROOT_ENERGIES_2', 'ROOT_INDICES',
                 'GRADIENT_DIFFERENCE'):
        if name not in f:
            fail('B2: %s dataset is missing' % name)
    if failures:
        sys.stderr.write('\n'.join(failures) + '\n')
        sys.exit(1)

    root_e = f['ROOT_ENERGIES'][...]
    root_e2 = f['ROOT_ENERGIES_2'][...]
    root_idx = f['ROOT_INDICES'][...]
    grad_diff = f['GRADIENT_DIFFERENCE'][...]

    if root_e.shape != (niter, nroots):
        fail('B2: ROOT_ENERGIES shape is %s, expected (ITERATIONS, NROOTS) = %s'
             % (root_e.shape, (niter, nroots)))
    if root_e2.shape != (niter, nroots2):
        fail('B2: ROOT_ENERGIES_2 shape is %s, expected (ITERATIONS, NROOTS_2) = %s'
             % (root_e2.shape, (niter, nroots2)))
    if grad_diff.shape[0] != niter:
        fail('B2: GRADIENT_DIFFERENCE leading dimension %d != ITERATIONS %d'
             % (grad_diff.shape[0], niter))

    # --- B3: ROOT_INDICES stays in bounds for each differently-sized array --
    # Column 0 selects within ROOT_ENERGIES (size NROOTS), column 1 within
    # ROOT_ENERGIES_2 (size NROOTS_2). With NROOTS != NROOTS_2 the two
    # columns have genuinely different valid ranges, so this is the only
    # test where an off-by-one or swapped-column bug cannot hide behind a
    # coincidentally-matching root count.
    if root_idx.shape != (niter, 2):
        fail('B3: ROOT_INDICES shape is %s, expected %s' % (root_idx.shape, (niter, 2)))
    else:
        col0 = root_idx[:, 0]
        col1 = root_idx[:, 1]
        if np.any(col0 < 1) or np.any(col0 > nroots):
            fail('B3: ROOT_INDICES column 0 has values outside [1, NROOTS=%d]: %s'
                 % (nroots, np.array2string(col0)))
        if np.any(col1 < 1) or np.any(col1 > nroots2):
            fail('B3: ROOT_INDICES column 1 has values outside [1, NROOTS_2=%d]: %s'
                 % (nroots2, np.array2string(col1)))

    # --- B4: no fill-value holes in either root-energies array --------------
    for name, arr in (('ROOT_ENERGIES', root_e), ('ROOT_ENERGIES_2', root_e2)):
        if not np.all(np.isfinite(arr)):
            bad = np.argwhere(~np.isfinite(arr))
            fail('B4: %s has %d non-finite entries, first at %s'
                 % (name, len(bad), tuple(bad[0])))
        zeros = np.argwhere(arr == 0.0)
        if len(zeros):
            fail('B4: %s has %d zero entries (fill-value holes?), first at %s'
                 % (name, len(zeros), tuple(zeros[0])))

    # --- B5: the EDiff=0 constraint is actually satisfied at the end --------
    # Cross-checks that ROOT_INDICES is being read with the documented
    # column convention (column 0 -> ROOT_ENERGIES, column 1 ->
    # ROOT_ENERGIES_2): with NROOTS != NROOTS_2 the reversed convention is
    # not just wrong but dimensionally nonsensical for most entries, so this
    # also doubles as a sanity check on the convention itself.
    if 'ENERGIES' not in f:
        fail('B5: ENERGIES dataset is missing')
    elif not failures:
        energies = f['ENERGIES'][...]
        k = niter - 1
        ri0, ri1 = int(root_idx[k, 0])-1, int(root_idx[k, 1])-1
        residual = root_e2[k, ri1] - (2.0*energies[k] - root_e[k, ri0])
        if abs(residual) > TOL:
            fail('B5: final-iteration EDiff residual = %.3e, expected ~0 '
                 '(ROOT_ENERGIES_2[%d,%d]=%.8f, ENERGIES[%d]=%.8f, '
                 'ROOT_ENERGIES[%d,%d]=%.8f)'
                 % (residual, k, ri1, root_e2[k, ri1], k, energies[k],
                    k, ri0, root_e[k, ri0]))

if failures:
    sys.stderr.write('\nslapaf.h5 structure check FAILED (%s)\n' % path)
    for item in failures:
        sys.stderr.write('  %s\n' % item)
    sys.exit(1)

for item in notes:
    sys.stdout.write('  note: %s\n' % item)
sys.stdout.write('slapaf.h5 asymmetric-root structure check passed: '
                 'ITERATIONS=%d NROOTS=%d NROOTS_2=%d ROOT_ENERGIES=%s '
                 'ROOT_ENERGIES_2=%s\n'
                 % (niter, nroots, nroots2, root_e.shape, root_e2.shape))
sys.exit(0)
>EOF

