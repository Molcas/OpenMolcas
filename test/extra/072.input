* Test if Tinker is available and skip the test if not
> RM -FORCE TEST_TINKER
> IF ( $MOLCAS_DRIVER = UNKNOWN_VARIABLE )
>   EXPORT MOLCAS_DRIVER=molcas
> ENDIF
> IF ( -FILE $MOLCAS/tinker/bin/tkr2qm_s )
>   EXPORT TINKER=$MOLCAS/tinker/bin
> ENDIF
> SHELL $MOLCAS_DRIVER have_feature tinker || touch TEST_TINKER
> IF ( -FILE TEST_TINKER )
>   EXIT 36
> ENDIF

> EXPORT MOLCAS_THR=1
> COPY start.xyz $Project.xyz
* trick to put the right path in the .key file
* (simply copying the .prm file would not work with num. grad.)
> SHELL echo "parameters $TINKER/../params/amber99.prm" > $Project.key
> SHELL cat start.key >> $Project.key

* another trick to set maximum memory
* (tinker requires quite a bit and crashes if memory is low)
> EXPORT MEMLIM=1024
> SHELL sh checkmem
> IF ( -FILE reduce_mem )
>   EXPORT MOLCAS_MEM=$MEMLIM
> ENDIF

 &Gateway
* Note that normally Expert & Coord are not needed,
* but here we want to test that they work as intended
Expert
Coord = 8
Angstrom
 C       0.0 0.0 0.0
 O_QM    0.0 0.0 0.0
 O_QM    0.0 0.0 0.0
 C       0.0 0.0 0.0
 H       0.0 0.0 0.0
 H       0.0 0.0 0.0
 C_MM    0.0 0.0 0.0
 H       0.0 0.0 0.0
Tinker
Basis = STO-3G,O...... / MM,O_QM.STO-3G
Group = Nosym
NoCD

> DO WHILE
 &Seward

 &Espf
External = Tinker
LAMorok

 &Rasscf
Charge  = -1
inactive = 14
ras2 = 4
CIRoot = 3 3 1
RlxRoot = 2

 &Slapaf
Cartesian
rHidden = 10 angstrom
Iter = 20
Thrshld = 0.0001 0.005
Rtrnc = 15 2.0 angstrom

> ENDDO

****

